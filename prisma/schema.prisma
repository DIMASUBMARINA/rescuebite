generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESTAURANT
  SHELTER
  DRIVER
  CONSUMER
  ADMIN
}

enum InventoryState {
  FRESH
  DISCOUNTED
  FREE
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  CLAIMED
  EXPIRED
}

enum PickupStatus {
  UNASSIGNED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Allergen {
  GLUTEN
  DAIRY
  EGGS
  FISH
  SHELLFISH
  TREE_NUTS
  PEANUTS
  WHEAT
  SOY
  SESAME
}


model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  phone         String?
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  refreshTokens        RefreshToken[]
  emailVerifications   EmailVerificationToken[]

  restaurant    Restaurant?
  shelter       Shelter?
  driver        Driver?
  orders        Order[]
  allergies     UserAllergy[]

  @@map("users")
}

model UserAllergy {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  allergen  Allergen

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, allergen])
  @@map("user_allergies")
}

model Restaurant {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  businessName  String   @map("business_name")
  address       String
  lat           Decimal  @db.Decimal(10, 8)
  lon           Decimal  @db.Decimal(11, 8)
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory   Inventory[]

  @@map("restaurants")
}

model Shelter {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  shelterName  String   @map("shelter_name")
  charityRegNo String?  @map("charity_reg_no")
  address      String
  lat          Decimal  @db.Decimal(10, 8)
  lon          Decimal  @db.Decimal(11, 8)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims  Claim[]

  @@map("shelters")
}

model Driver {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  licenseNo    String   @map("license_no")
  vehiclePlate String   @map("vehicle_plate")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickups  Pickup[]

  @@map("drivers")
}

model Inventory {
  id           String         @id @default(uuid())
  restaurantId String         @map("restaurant_id")
  name         String
  description  String?
  originalPrice Decimal       @db.Decimal(10, 2) @map("original_price")
  currentPrice  Decimal       @db.Decimal(10, 2) @map("current_price")
  state        InventoryState @default(FRESH)
  quantity     Int            @default(1)
  reservedQty  Int            @default(0) @map("reserved_qty")
  createdAt    DateTime       @default(now()) @map("created_at")
  expiresAt    DateTime       @map("expires_at")
  ingredients  Json
  allergens    Allergen[]

  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  claim        Claim?

  @@index([restaurantId])
  @@index([state])
  @@index([expiresAt])
  @@map("inventory")
}

model Order {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  inventoryId    String      @unique @map("inventory_id")
  status         OrderStatus @default(PENDING)
  totalPrice     Decimal     @db.Decimal(10, 2) @map("total_price")
  reservedUntil  DateTime?   @map("reserved_until")
  
  deliveryAddress String?    @map("delivery_address")
  deliveryLat     Decimal?   @db.Decimal(10, 8) @map("delivery_lat")
  deliveryLon     Decimal?   @db.Decimal(11, 8) @map("delivery_lon")
  deliveryFee     Decimal?   @db.Decimal(10, 2) @map("delivery_fee")
  isDelivery      Boolean    @default(false) @map("is_delivery")
  
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id])
  inventory  Inventory @relation(fields: [inventoryId], references: [id])
  pickup     Pickup?

  @@map("orders")
}

model Claim {
  id          String      @id @default(uuid())
  inventoryId String      @unique @map("inventory_id")
  shelterId   String      @map("shelter_id")
  status      ClaimStatus @default(PENDING)
  claimedAt   DateTime?   @map("claimed_at")
  expiresAt   DateTime    @map("expires_at")

  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  shelter     Shelter   @relation(fields: [shelterId], references: [id])
  pickup      Pickup?

  @@map("claims")
}

enum PickupType {
  SHELTER_DELIVERY
  CONSUMER_DELIVERY
}

model Pickup {
  id          String      @id @default(uuid())
  claimId     String?     @unique @map("claim_id")
  orderId     String?     @unique @map("order_id")
  driverId    String?     @map("driver_id")
  type        PickupType  @default(SHELTER_DELIVERY)
  status      PickupStatus @default(UNASSIGNED)
  assignedAt  DateTime?   @map("assigned_at")
  pickedUpAt  DateTime?   @map("picked_up_at")
  deliveredAt DateTime?   @map("delivered_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  claim       Claim?      @relation(fields: [claimId], references: [id])
  order       Order?      @relation(fields: [orderId], references: [id])
  driver      Driver?     @relation(fields: [driverId], references: [id])

  @@map("pickups")
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  field     String?
  oldValue  String?  @map("old_value")
  newValue  String   @map("new_value")
  changedBy String   @map("changed_by")
  ipAddress String?  @map("ip_address")
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([entity, entityId])
  @@index([changedAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model WasteLog {
  id             String   @id @default(uuid())
  restaurantId   String   @map("restaurant_id")
  inventoryId    String   @map("inventory_id")
  quantity       Int
  disposalMethod String   @map("disposal_method")
  loggedAt       DateTime @default(now()) @map("logged_at")

  @@map("waste_logs")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}
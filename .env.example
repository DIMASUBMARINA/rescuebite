DATABASE_URL="postgresql://user:password@localhost:5432/rescuebite"
JWT_SECRET="minimum-32-characters-long-secret-here"
PORT=3000
NODE_ENV=development

# AgentMail — get your API key at https://console.agentmail.to
AGENTMAIL_API_KEY="am_..."
